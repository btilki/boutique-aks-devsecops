terraform/modules/**/.terraform.lock.hcl
*.tfstate
*.tfstate.*
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
*.tfvars
!*.tfvars.example
*.tfplan
tfplan
**/tfplan

# Secrets and keys
*.pem
*.key
cosign.key
.env
.env.*

# OS and editor
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# Python / pre-commit
__pycache__/
.venv/

# Build artifacts
*.log
dist/
build/

# Local kubeconfig copies
kubeconfig
kubeconfig.*

# Local ZAP DAST output (Topic 20)
.zap-out/
